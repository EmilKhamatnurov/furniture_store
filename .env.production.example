# =============================================================================
# PRODUCTION runtime env — copy to .env.production and fill in real values.
# Loaded by the app, worker and migrate containers (env_file in docker-compose).
# NEVER commit the real .env.production. Keep secrets out of git.
# =============================================================================

NODE_ENV=production

# --- App ---
# Public site URL (used for canonical/OG links, payment return URLs, emails)
NEXT_PUBLIC_APP_URL=https://shop.example.ru
# Session/cookie signing secret — generate: openssl rand -hex 32  (>= 32 chars)
APP_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# --- Database & cache (use the compose service names on the internal network) ---
# Password must match POSTGRES_PASSWORD in the project-root .env
DATABASE_URL=postgresql://furniture_user:CHANGE_ME_DB_PASSWORD@postgres:5432/furniture_shop
REDIS_URL=redis://redis:6379

# --- S3 / object storage (Selectel) — media for products & blog ---
S3_ENDPOINT=https://s3.selcdn.ru
S3_REGION=ru-1
S3_BUCKET=furniture-shop-media
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_PUBLIC_HOSTNAME=s3.selcdn.ru

# --- YuKassa payments ---
YUKASSA_SHOP_ID=CHANGE_ME
YUKASSA_SECRET_KEY=CHANGE_ME
YUKASSA_WEBHOOK_SECRET=CHANGE_ME

# --- Email (Unisender Go) ---
UNISENDER_API_KEY=CHANGE_ME
EMAIL_FROM=noreply@shop.example.ru
EMAIL_FROM_NAME=KHAMATNUROV MEBEL

# --- Admin panel (email + base64 scrypt hash; generate: npm run admin:hash -- "pass") ---
ADMIN_EMAIL=admin@shop.example.ru
ADMIN_PASSWORD_HASH=CHANGE_ME_base64_hash_from_admin_hash_script

# --- Optional ---
SMS_AERO_EMAIL=
SMS_AERO_API_KEY=
SMS_AERO_SIGN=
GLITCHTIP_DSN=
NEXT_PUBLIC_METRIKA_COUNTER_ID=
# SEO ownership verification (paste values from Yandex.Webmaster / Google Search Console)
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
