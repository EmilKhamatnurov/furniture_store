# =============================================================================
# Furniture Shop — Caddyfile
# Replace {$DOMAIN} with your actual domain in .env.production
# =============================================================================

{$DOMAIN} {
    # Automatic HTTPS — Let's Encrypt
    tls {
        protocols tls1.2 tls1.3
    }

    # Security headers (defence in depth — also set in Next.js middleware)
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # NOTE: Content-Security-Policy is set per-request (with a nonce) by the
        # Next.js middleware (src/middleware.ts), not here — a static CSP would
        # conflict with the nonce-based one.
        -Server
    }

    # Proxy to Next.js app container
    reverse_proxy app:3000 {
        health_uri /api/health
        health_interval 30s
    }

    # Serve uploaded media directly from Caddy if needed
    # (prefer S3 + CDN for production)

    log {
        output stdout
        format json
        level INFO
    }
}
