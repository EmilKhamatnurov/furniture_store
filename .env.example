# =============================================================================
# FURNITURE SHOP — Environment Variables
# Copy to .env.local for local dev. Never commit .env.local or .env.production
# =============================================================================

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=change-me-min-32-chars-random-string

# --- Database ---
DATABASE_URL=postgresql://furniture_user:furniture_pass@localhost:5432/furniture_shop

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- S3 / Object Storage (Selectel) ---
# Dev: leave keys AND NEXT_PUBLIC_S3_BASE_URL empty — admin uploads then go to
# public/uploads/ and are served locally as /uploads/<key>.
# Prod: set keys + NEXT_PUBLIC_S3_BASE_URL=https://s3.selcdn.ru/furniture-shop-media
S3_ENDPOINT=https://s3.selcdn.ru
S3_REGION=ru-1
S3_BUCKET=furniture-shop-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_HOSTNAME=s3.selcdn.ru
NEXT_PUBLIC_S3_BASE_URL=

# --- YuKassa Payments ---
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
# Webhook secret for signature verification
YUKASSA_WEBHOOK_SECRET=

# --- Email (Unisender Go) ---
UNISENDER_API_KEY=
EMAIL_FROM=noreply@yourdomain.ru
EMAIL_FROM_NAME=KHAMATNUROV MEBEL
# Admin notifications recipient (falls back to EMAIL_FROM)
ADMIN_EMAIL=
# Admin panel login — base64 scrypt hash (generate: npm run admin:hash -- "pass")
ADMIN_PASSWORD_HASH=

# --- SMS Aero (optional) ---
SMS_AERO_EMAIL=
SMS_AERO_API_KEY=
SMS_AERO_SIGN=

# --- Error Monitoring (GlitchTip self-hosted) ---
GLITCHTIP_DSN=

# --- Yandex.Metrika ---
NEXT_PUBLIC_METRIKA_COUNTER_ID=
# SEO ownership verification (paste values from Yandex.Webmaster / Google Search Console)
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
